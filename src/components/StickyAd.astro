---
const adClient = "ca-pub-9288807135824382";
const adSlot   = "8195761770";
---

<div class="sticky-ad-wrap">
  <ins
    class="adsbygoogle sticky-ad-ins"
    style="display:block;"
    data-ad-client={adClient}
    data-ad-slot={adSlot}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>

<style>
  .sticky-ad-wrap {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #fff;
    border-top: 1px solid #e0d8d4;
    padding: 6px 0;
    padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));
  }

  .sticky-ad-ins {
    width: 100%;
    min-height: 50px;
  }
</style>
