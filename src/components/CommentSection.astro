---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="comments" data-slug={slug}>
  <h2 class="comments-title">コメント</h2>

  <div id="comment-list" class="comment-list">
    <p class="loading">読み込み中…</p>
  </div>

  <form id="comment-form" class="comment-form" novalidate>
    <div class="form-group">
      <label for="comment-name">お名前<span class="optional">（任意）</span></label>
      <input
        type="text"
        id="comment-name"
        name="name"
        placeholder="匿名"
        maxlength="50"
        autocomplete="name"
      />
    </div>
    <div class="form-group">
      <label for="comment-body">コメント<span class="required">*</span></label>
      <textarea
        id="comment-body"
        name="body"
        placeholder="感想や一言をどうぞ"
        rows="4"
        maxlength="1000"
        required
      ></textarea>
    </div>
    <p id="comment-error" class="form-error" hidden></p>
    <button type="submit" id="comment-submit">送信する</button>
  </form>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const section = document.querySelector<HTMLElement>('.comments')!;
  const slug = section.dataset.slug!;
  const listEl = document.getElementById('comment-list')!;
  const form = document.getElementById('comment-form') as HTMLFormElement;
  const errorEl = document.getElementById('comment-error')!;
  const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement;

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleString('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  async function loadComments() {
    const { data, error } = await supabase
      .from('comments')
      .select('id, name, body, created_at')
      .eq('post_slug', slug)
      .eq('approved', true)
      .order('created_at', { ascending: false });

    if (error || !data) {
      listEl.innerHTML = '<p class="load-error">コメントを読み込めませんでした。</p>';
      return;
    }

    if (data.length === 0) {
      listEl.innerHTML = '<p class="no-comments">まだコメントはありません。最初の一言を残してみませんか？</p>';
      return;
    }

    listEl.innerHTML = data
      .map(
        (c) => `
      <div class="comment-item">
        <div class="comment-meta">
          <span class="comment-name">${escapeHtml(c.name || '匿名')}</span>
          <time class="comment-date">${formatDate(c.created_at)}</time>
        </div>
        <p class="comment-body">${escapeHtml(c.body).replace(/\n/g, '<br>')}</p>
      </div>`
      )
      .join('');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();

    if (!body) {
      errorEl.textContent = 'コメント本文を入力してください。';
      errorEl.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '送信中…';

    const { error } = await supabase.from('comments').insert({
      post_slug: slug,
      name: name || null,
      body,
    });

    submitBtn.disabled = false;
    submitBtn.textContent = '送信する';

    if (error) {
      errorEl.textContent = '送信に失敗しました。しばらくしてからお試しください。';
      errorEl.hidden = false;
      return;
    }

    form.reset();
    errorEl.style.color = '#4a8a4a';
    errorEl.textContent = 'コメントを受け付けました。確認後に公開されます。';
    errorEl.hidden = false;
    setTimeout(() => { errorEl.hidden = true; errorEl.style.color = ''; }, 5000);
    await loadComments();
  });

  loadComments();
</script>

<style>
  .comments {
    max-width: 720px;
    margin: 72px auto 0;
    padding-top: 48px;
    border-top: 1px solid #f0e8e4;
  }

  .comments-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  /* ── コメント一覧 ── */
  .comment-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 48px;
  }

  .comment-item {
    background: #fdf8f5;
    border-radius: 12px;
    padding: 20px 24px;
  }

  .comment-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .comment-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .comment-date {
    font-size: 0.75rem;
    color: #c0a090;
    letter-spacing: 0.04em;
  }

  .comment-body {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #2e2e2e;
    margin: 0;
  }

  .no-comments,
  .loading,
  .load-error {
    font-size: 0.9rem;
    color: #999;
  }

  /* ── フォーム ── */
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
  }

  .optional {
    font-size: 0.75rem;
    color: #aaa;
    margin-left: 4px;
  }

  .required {
    color: #b5352a;
    margin-left: 2px;
  }

  .comment-form input,
  .comment-form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e8ddd8;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1a1a1a;
    background: #fff;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .comment-form input:focus,
  .comment-form textarea:focus {
    outline: none;
    border-color: #b5352a;
  }

  .comment-form textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-error {
    font-size: 0.85rem;
    color: #b5352a;
    margin: 0;
  }

  #comment-submit {
    align-self: flex-start;
    padding: 12px 28px;
    background: #b5352a;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  #comment-submit:hover {
    background: #9c2d23;
  }

  #comment-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 600px) {
    .comments {
      margin-top: 48px;
      padding-top: 32px;
    }
  }
</style>
