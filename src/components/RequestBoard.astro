---
---

<section class="request-board" data-slug="reader-request">
  <h2 class="request-title">次どこ行く？リクエスト</h2>
  <p class="request-lead">
    「このエリア気になる」「この系統食べてほしい」なんでもOK。届いたリクエストの中から実際に行ってきて、記事にします。
  </p>

  <form id="request-form" class="request-form" novalidate>
    <div class="form-group">
      <label for="request-name">お名前<span class="optional">（任意）</span></label>
      <input
        type="text"
        id="request-name"
        name="name"
        placeholder="匿名"
        maxlength="50"
        autocomplete="name"
      />
    </div>
    <div class="form-group">
      <label for="request-body">リクエスト内容<span class="required">*</span></label>
      <textarea
        id="request-body"
        name="body"
        placeholder="例：三軒茶屋の二郎系が気になる／渋谷でつけ麺希望"
        rows="3"
        maxlength="300"
        required
      ></textarea>
    </div>
    <p id="request-error" class="form-error" hidden></p>
    <button type="submit" id="request-submit">リクエストする</button>
  </form>

  <div class="request-list-wrap">
    <p class="request-list-label">みんなのリクエスト</p>
    <div id="request-list" class="request-list">
      <p class="loading">読み込み中…</p>
    </div>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const REQUEST_SLUG = 'reader-request';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const listEl = document.getElementById('request-list')!;
  const form = document.getElementById('request-form') as HTMLFormElement;
  const errorEl = document.getElementById('request-error')!;
  const submitBtn = document.getElementById('request-submit') as HTMLButtonElement;

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleDateString('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  }

  async function loadRequests() {
    const { data, error } = await supabase
      .from('comments')
      .select('id, name, body, created_at')
      .eq('post_slug', REQUEST_SLUG)
      .eq('approved', true)
      .order('created_at', { ascending: false });

    if (error || !data) {
      listEl.innerHTML = '<p class="load-error">読み込めませんでした。</p>';
      return;
    }

    if (data.length === 0) {
      listEl.innerHTML = '<p class="no-requests">まだリクエストはありません。一番乗りしてみる？</p>';
      return;
    }

    listEl.innerHTML = data
      .map(
        (r) => `
      <div class="request-item">
        <div class="request-meta">
          <span class="request-name">${escapeHtml(r.name || '匿名')}</span>
          <time class="request-date">${formatDate(r.created_at)}</time>
        </div>
        <p class="request-body">${escapeHtml(r.body).replace(/\n/g, '<br>')}</p>
      </div>`
      )
      .join('');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();

    if (!body) {
      errorEl.textContent = 'リクエスト内容を入力してください。';
      errorEl.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '送信中…';

    const { error } = await supabase.from('comments').insert({
      post_slug: REQUEST_SLUG,
      name: name || null,
      body,
    });

    submitBtn.disabled = false;
    submitBtn.textContent = 'リクエストする';

    if (error) {
      errorEl.textContent = '送信に失敗しました。しばらくしてからお試しください。';
      errorEl.hidden = false;
      return;
    }

    form.reset();
    errorEl.style.color = '#4a8a4a';
    errorEl.textContent = 'リクエストを受け付けました。確認後に公開されます。';
    errorEl.hidden = false;
    setTimeout(() => { errorEl.hidden = true; errorEl.style.color = ''; }, 5000);
    await loadRequests();
  });

  loadRequests();
</script>

<style>
  .request-board {
    max-width: 720px;
    margin: 0 auto;
  }

  .request-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }

  .request-lead {
    font-size: 0.9rem;
    color: #888;
    line-height: 1.85;
    margin-bottom: 32px;
  }

  .request-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 48px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
  }

  .optional {
    font-size: 0.75rem;
    color: #aaa;
    margin-left: 4px;
  }

  .required {
    color: #b5352a;
    margin-left: 2px;
  }

  .request-form input,
  .request-form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e8ddd8;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1a1a1a;
    background: #fff;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .request-form input:focus,
  .request-form textarea:focus {
    outline: none;
    border-color: #b5352a;
  }

  .request-form textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-error {
    font-size: 0.85rem;
    color: #b5352a;
    margin: 0;
  }

  #request-submit {
    align-self: flex-start;
    padding: 12px 28px;
    background: #b5352a;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  #request-submit:hover { background: #9c2d23; }
  #request-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .request-list-label {
    font-size: 0.78rem;
    color: #bbb;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
  }

  .request-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .request-item {
    background: #fdf8f5;
    border-radius: 12px;
    padding: 16px 20px;
  }

  .request-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .request-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .request-date {
    font-size: 0.72rem;
    color: #c0a090;
    letter-spacing: 0.04em;
  }

  .request-body {
    font-size: 0.9rem;
    line-height: 1.8;
    color: #2e2e2e;
    margin: 0;
  }

  .no-requests,
  .loading,
  .load-error {
    font-size: 0.88rem;
    color: #999;
  }

  @media (max-width: 600px) {
    .request-board { margin-top: 8px; }
  }
</style>
