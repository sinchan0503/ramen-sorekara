---
---

<section class="request-board" data-slug="reader-request">
  <h2 class="request-title">次どこ行く？リクエスト</h2>
  <p class="request-lead">
    「このエリア気になる」「この系統食べてほしい」なんでもOK。届いたリクエストの中から実際に行ってきて、記事にします。
  </p>

  <form action="https://formspree.io/f/xyklagkn" method="POST" class="request-form">
    <input type="hidden" name="_subject" value="【ラーメンそれから】次どこ行く？リクエスト" />
    <div class="form-group">
      <label for="request-name">お名前<span class="optional">（任意）</span></label>
      <input
        type="text"
        id="request-name"
        name="name"
        placeholder="匿名"
        maxlength="50"
        autocomplete="name"
      />
    </div>
    <div class="form-group">
      <label for="request-body">リクエスト内容<span class="required">*</span></label>
      <textarea
        id="request-body"
        name="message"
        placeholder="例：三軒茶屋の二郎系が気になる／渋谷でつけ麺希望"
        rows="3"
        maxlength="300"
        required
      ></textarea>
    </div>
    <button type="submit">リクエストする</button>
  </form>
</section>

<style>
  .request-board {
    max-width: 720px;
    margin: 0 auto;
  }

  .request-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }

  .request-lead {
    font-size: 0.9rem;
    color: #888;
    line-height: 1.85;
    margin-bottom: 32px;
  }

  .request-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
  }

  .optional {
    font-size: 0.75rem;
    color: #aaa;
    margin-left: 4px;
  }

  .required {
    color: #b5352a;
    margin-left: 2px;
  }

  .request-form input,
  .request-form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e8ddd8;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1a1a1a;
    background: #fff;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .request-form input:focus,
  .request-form textarea:focus {
    outline: none;
    border-color: #b5352a;
  }

  .request-form textarea {
    resize: vertical;
    min-height: 80px;
  }

  button {
    align-self: flex-start;
    padding: 12px 28px;
    background: #b5352a;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  button:hover { background: #9c2d23; }

  @media (max-width: 600px) {
    .request-board { margin-top: 8px; }
  }
</style>
