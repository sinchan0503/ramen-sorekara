---
import StickyAd from '../components/StickyAd.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
}
const {
  title = 'ラーメンブログ｜ラーメン、それから。',
  description = '東京のラーメンブログ。ラーメンがモンブランにしか見えないOLが食べて書く、東京ラーメンレビュー。',
  noindex = false,
  image,
  ogType = 'website',
} = Astro.props;
const siteUrl = 'https://www.ramen-sorekara.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/images/pon-hero.png`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ラーメン、それから。" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <!-- preconnect: フォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- preconnect: 広告・計測 -->
    <link rel="preconnect" href="https://pagead2.googlesyndication.com">
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://www.clarity.ms">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;600&family=Klee+One:wght@600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;600&family=Klee+One:wght@600&display=swap"></noscript>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9288807135824382" crossorigin="anonymous"></script>
    <script>(adsbygoogle = window.adsbygoogle || []).push({ overlays: {bottom: false} });</script>
    <!-- Microsoft Clarity（ヒートマップ） -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wsl4uer3g7");
    </script>
    <!-- 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "ラーメン、それから。",
          "description": "東京のラーメンブログ。ラーメンがモンブランにしか見えないOLが食べて書く、東京ラーメンレビュー。",
          "inLanguage": "ja",
          "potentialAction": {
            "@type": "SearchAction",
            "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/blog?q={search_term_string}` },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "ItemList",
          "name": "メインナビゲーション",
          "itemListElement": [
            { "@type": "SiteNavigationElement", "position": 1, "name": "記事一覧", "url": `${siteUrl}/blog` },
            { "@type": "SiteNavigationElement", "position": 2, "name": "らーめんマップ", "url": `${siteUrl}/map` },
            { "@type": "SiteNavigationElement", "position": 3, "name": "四コマ", "url": `${siteUrl}/4koma` },
            { "@type": "SiteNavigationElement", "position": 4, "name": "このブログについて", "url": `${siteUrl}/about` }
          ]
        }
      ]
    })} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BHSV274KR6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BHSV274KR6');
    </script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
        background-color: #fdf8f3;
        background-image: linear-gradient(rgba(253,248,243,0.78), rgba(253,248,243,0.78)), url('/images/bg-pattern.jpg');
        background-repeat: repeat;
        background-size: 480px auto;
        color: #2a2a2a;
        line-height: 1.9;
      }
      header {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid #f0e8e4;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      header a { text-decoration: none; }
      .site-title {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .site-title img {
        width: 36px;
        height: 36px;
        display: block;
        flex-shrink: 0;
      }
      .site-title-text {
        font-family: 'Klee One', cursive;
        font-weight: 600;
        font-size: 1.1rem;
        color: #b5352a;
        letter-spacing: 0.06em;
      }
      nav { display: flex; }
      nav a {
        color: #888;
        text-decoration: none;
        padding: 6px 10px;
        font-size: 0.82rem;
        font-weight: 500;
        border-radius: 20px;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
      }
      nav a:hover { background: #fdf0ed; color: #b5352a; }
      .header-top { display: contents; }
      .nav-sub { display: none; }
      main {
        max-width: 1200px;
        margin: 48px auto;
        padding: 0 24px;
      }
      .main-inner {
        background: rgba(253, 248, 243, 0.92);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        border-radius: 20px;
        padding: 48px 40px;
      }
      footer {
        text-align: center;
        padding: 40px 20px 110px;
        color: #aaa;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        background: rgba(253, 248, 243, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        margin-top: 0;
      }
      @media (max-width: 600px) {
        header { padding: 0 12px; }
        .header-inner { height: auto; padding: 8px 0; flex-direction: column; align-items: flex-start; gap: 4px; }
        /* タイトル行：サイト名 + ゲーム・お問い合わせ */
        .header-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }
        .nav-sub { display: flex; gap: 0; flex-shrink: 0; }
        .nav-sub a { color: #888; text-decoration: none; padding: 4px 6px; font-size: 0.72rem; font-weight: 500; white-space: nowrap; }
        /* メインナビ：ホーム・記事一覧・四コマ・このブログについて */
        nav { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        nav a { padding: 4px 8px; font-size: 0.75rem; }
        /* メインナビからゲーム・お問い合わせを隠す */
        nav .hide-sp { display: none; }
        main { margin: 24px auto; padding: 0 12px; }
        .main-inner { padding: 24px 16px; border-radius: 14px; }
        footer { padding-bottom: 70px; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <div class="header-top">
          <a href="/" class="site-title">
            <img src="/images/logo-ramen.svg" alt="" aria-hidden="true" />
            <span class="site-title-text">ラーメン、それから。</span>
          </a>
          <div class="nav-sub">
            <a href="/game">🎮 ゲーム</a>
            <a href="/contact">お問い合わせ</a>
          </div>
        </div>
        <nav>
          <a href="/">ホーム</a>
          <a href="/blog">記事一覧</a>
          <a href="/4koma">四コマ</a>
          <a href="/map">マップ</a>
          <a href="/about">このブログについて</a>
          <a href="/game" class="hide-sp">🎮 ゲーム</a>
          <a href="/contact" class="hide-sp">お問い合わせ</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="main-inner">
        <slot />
      </div>
    </main>
    <footer>
      <p>© 2026 ラーメン、それから。</p>
      <p style="margin-top: 8px;"><a href="/privacy" style="color: #bbb; text-decoration: none;">プライバシーポリシー</a></p>
      <p style="margin-top: 16px;">
        <a href="https://gourmet.blogmura.com/tokyoramen/ranking/in?p_cid=11215995" target="_blank" rel="noopener">
          <img src="https://b.blogmura.com/gourmet/tokyoramen/88_31.gif" width="88" height="31" border="0" alt="にほんブログ村 グルメブログ 東京ラーメン食べ歩きへ" />
        </a>
        <br />
        <a href="https://gourmet.blogmura.com/tokyoramen/ranking/in?p_cid=11215995" target="_blank" rel="noopener" style="color: #bbb; font-size: 0.75rem; text-decoration: none;">にほんブログ村</a>
      </p>
    </footer>
    <StickyAd />
  </body>
</html>
