---
import StickyAd from '../components/StickyAd.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = 'ラーメンブログ｜ラーメン、それから。', description = '東京のラーメンブログ。ラーメンがモンブランにしか見えないOLが食べて書く、東京ラーメンレビュー。', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://ramen-sorekara.com');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ラーメン、それから。" />
    <meta property="og:locale" content="ja_JP" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;600&family=Klee+One:wght@600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;600&family=Klee+One:wght@600&display=swap"></noscript>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9288807135824382" crossorigin="anonymous"></script>
    <!-- Microsoft Clarity（ヒートマップ） -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wsl4uer3g7");
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BHSV274KR6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BHSV274KR6');
    </script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
        background-color: #fdf8f3;
        background-image: linear-gradient(rgba(253,248,243,0.78), rgba(253,248,243,0.78)), url('/images/bg-pattern.jpg');
        background-repeat: repeat;
        background-size: 480px auto;
        color: #2a2a2a;
        line-height: 1.9;
      }
      header {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid #f0e8e4;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      header a { text-decoration: none; }
      .site-title {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .site-title img {
        width: 36px;
        height: 36px;
        display: block;
        flex-shrink: 0;
      }
      .site-title-text {
        font-family: 'Klee One', cursive;
        font-weight: 600;
        font-size: 1.1rem;
        color: #b5352a;
        letter-spacing: 0.06em;
      }
      nav { display: flex; }
      nav a {
        color: #888;
        text-decoration: none;
        padding: 6px 10px;
        font-size: 0.82rem;
        font-weight: 500;
        border-radius: 20px;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
      }
      nav a:hover { background: #fdf0ed; color: #b5352a; }
      .header-top { display: contents; }
      .nav-sub { display: none; }
      main {
        max-width: 1200px;
        margin: 48px auto;
        padding: 0 24px;
      }
      .main-inner {
        background: rgba(253, 248, 243, 0.92);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        border-radius: 20px;
        padding: 48px 40px;
      }
      footer {
        text-align: center;
        padding: 40px 20px;
        color: #aaa;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        background: rgba(253, 248, 243, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        margin-top: 0;
      }
      @media (max-width: 600px) {
        header { padding: 0 12px; }
        .header-inner { height: auto; padding: 8px 0; flex-direction: column; align-items: flex-start; gap: 4px; }
        /* タイトル行：サイト名 + ゲーム・お問い合わせ */
        .header-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }
        .nav-sub { display: flex; gap: 0; flex-shrink: 0; }
        .nav-sub a { color: #888; text-decoration: none; padding: 4px 6px; font-size: 0.72rem; font-weight: 500; white-space: nowrap; }
        /* メインナビ：ホーム・記事一覧・四コマ・このブログについて */
        nav { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        nav a { padding: 4px 8px; font-size: 0.75rem; }
        /* メインナビからゲーム・お問い合わせを隠す */
        nav .hide-sp { display: none; }
        main { margin: 24px auto; padding: 0 12px; }
        .main-inner { padding: 24px 16px; border-radius: 14px; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <div class="header-top">
          <a href="/" class="site-title">
            <img src="/images/logo-ramen.svg" alt="" aria-hidden="true" />
            <span class="site-title-text">ラーメン、それから。</span>
          </a>
          <div class="nav-sub">
            <a href="/game">🎮 ゲーム</a>
            <a href="/contact">お問い合わせ</a>
          </div>
        </div>
        <nav>
          <a href="/">ホーム</a>
          <a href="/blog">記事一覧</a>
          <a href="/4koma">四コマ</a>
          <a href="/about">このブログについて</a>
          <a href="/game" class="hide-sp">🎮 ゲーム</a>
          <a href="/contact" class="hide-sp">お問い合わせ</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="main-inner">
        <slot />
      </div>
    </main>
    <footer>
      <p>© 2026 ラーメン、それから。</p>
      <p style="margin-top: 8px;"><a href="/privacy" style="color: #bbb; text-decoration: none;">プライバシーポリシー</a></p>
    </footer>
    <StickyAd />
  </body>
</html>
