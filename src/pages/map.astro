---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? 'AIzaSyBGTnyVaOpnFnWHyyM1_lm7zcRs2jnwQsw';

const hardcodedShops = [
  { name: 'らーめん護什番',              area: '雑司ヶ谷',  slug: 'gojuban-zoshigaya',          image: '/images/gojuban-01.jpg',              lat: 35.718925, lng: 139.721954 },
  { name: '伍福軒',                      area: '池袋',      slug: 'gofukuken-ikebukuro',         image: '/images/gofukuken-01.jpg',            lat: 35.732609, lng: 139.710251 },
  { name: 'ラーメン富士丸 神谷本店',      area: '志茂',      slug: 'fujimaru-kamiya',             image: '/images/fujimaru-01.jpg',             lat: 35.772289, lng: 139.733139 },
  { name: 'ひろちゃんラーメン',           area: '池袋',      slug: 'hirochan-ramen-ikebukuro',    image: '/images/hirochan-ramen-ikebukuro.jpg',lat: 35.732677, lng: 139.709732 },
  { name: 'らーめん HAGGY',              area: '調布',      slug: 'haggy-chofu',                 image: '/images/haggy-chofu-1.jpg',           lat: 35.654694, lng: 139.567017 },
  { name: '寿限無 担々麺',               area: '上野',      slug: 'jugemu-tantanmen-ueno',       image: '/images/jugemu-tantanmen-ueno.jpg',   lat: 35.708279, lng: 139.775787 },
  { name: 'ラーメンショップ マルQ',       area: '練馬',      slug: 'maruq-nerima',                image: '/images/maruq-nerima-01.jpg',         lat: 35.737572, lng: 139.653061 },
  { name: '安ざわ家',                    area: '練馬',      slug: 'anzawaya-nerima',             image: '/images/anzawaya-nerima-01.jpg',      lat: 35.736214, lng: 139.655533 },
  { name: '中華そば 麒麟',               area: '池袋',      slug: 'kirin-ikebukuro',             image: '/images/kirin-ikebukuro-1.jpg',       lat: 35.732422, lng: 139.707642 },
  { name: 'ミゾグチヤ',                   area: '東十条',    slug: 'mizoguchiya-higashijujo',     image: '/images/mizoguchiya-01.jpg',          lat: 35.765549, lng: 139.726501 },
  { name: 'ろく月',                      area: '浅草橋',    slug: 'rokugatu-asakusabashi',       image: '/images/rokugatu-1.jpg',              lat: 35.698879, lng: 139.785263 },
  { name: 'すず鬼 狭山ヶ丘分店',         area: '狭山ヶ丘',  slug: 'suzuki-sayamagaoka',          image: '/images/suzuki-sayamagaoka.jpg',      lat: 35.811855, lng: 139.415298 },
  { name: 'すず鬼 三鷹',                area: '三鷹',      slug: 'suzuki-mitaka',               image: '/images/suzuki-mitaka.jpg',           lat: 35.699482, lng: 139.561157 },
  { name: '屋台ラーメン しゅんやっちゃん', area: '高尾',      slug: 'shunyacchan-takao',           image: '/images/shunyacchan-takao-2.jpg',     lat: 35.641136, lng: 139.285461 },
  { name: 'つじ田',                      area: '飯田橋',    slug: 'tsujita-asa-iidabashi',       image: '/images/tsujita-asa-iidabashi.jpg',   lat: 35.701359, lng: 139.746323 },
  { name: 'たた味',                       area: '日本橋',    slug: 'tatami-nihonbashi',           image: '/images/tatami-nihonbashi.jpg',       lat: 35.691578, lng: 139.779663 },
  { name: '麺家たいせい',                area: '中野坂上',  slug: 'taisei-nakano',               image: '/images/taisei-nakano-02.jpg',        lat: 35.697205, lng: 139.682175 },
  { name: '豚骨蒼翔',                   area: '杉並',      slug: 'sosho-suginami',              image: '/images/sosho-suginami-01.jpg',       lat: 35.697590, lng: 139.660141 },
  { name: 'スタミナラーメン鬼山',         area: '渋谷',      slug: 'stamina-oniyama-shibuya',     image: '/images/stamina-oniyama-1.jpg',       lat: 35.659397, lng: 139.698318 },
  { name: '新宿シンちゃんラーメン',       area: '新宿',      slug: 'shinchan-shinjuku',           image: '/images/shinchan-shinjuku-01.jpg',    lat: 35.693890, lng: 139.703613 },
  { name: 'にじゅうぶんのいち',           area: '東尾久',    slug: 'nijubun-no-ichi-higashogu',   image: '/images/nijubun-no-ichi-01.jpg',      lat: 35.739967, lng: 139.771347 },
  { name: '超ごってり麺 ごっつ',          area: '秋葉原',    slug: 'gottsu-akihabara',            image: '/images/gottsu-akihabara.jpg',        lat: 35.700535, lng: 139.775192 },
  { name: '銀座はるちゃんラーメン',        area: '銀座',      slug: 'haruchan-ramen-ginza',        image: '/images/haruchan-ramen-ginza-03.jpg', lat: 35.670845, lng: 139.768890 },
  { name: 'らぁ麺 はやし田',              area: '池袋',      slug: 'hayashida-ramen-ikebukuro',   image: '/images/hayashida-ikebukuro-1.jpg',   lat: 35.732231, lng: 139.713882 },
  { name: 'RAMEN紫苑',                   area: '高田馬場',  slug: 'shion-takadanobaba',          image: '/images/shion-takadanobaba-01.jpg',   lat: 35.713444, lng: 139.708908 },
  { name: 'SUPER MEN',                  area: '飯田橋',    slug: 'supermen-iidabashi',          image: '/images/supermen-iidabashi-1.jpg',    lat: 35.699883, lng: 139.748215 },
  { name: 'なぎちゃんラーメン 高田馬場',  area: '高田馬場',  slug: 'nagichan-ramen-takadanobaba', image: '/images/nagichan-takadanobaba-1.jpg', lat: 35.713657, lng: 139.703613 },
  { name: 'MENSHO',                     area: '護国寺',    slug: 'mensho-otowa',                image: '/images/mensho-otowa-1.jpg',          lat: 35.716312, lng: 139.728668 },
  { name: 'RaMen TOMO TOKYO',           area: '九段下',    slug: 'tomo-tokyo-kudanshita',       image: '/images/tomo-tokyo-kudanshita-1.jpg', lat: 35.697521, lng: 139.751099 },
  { name: '支那麺はしご 本店',           area: '銀座',      slug: 'hashigo-ginza',               image: '/images/hashigo-ginza-1.jpg',         lat: 35.671589, lng: 139.761459 },
  { name: '自家製麺No11',               area: '志茂',      slug: 'jikaseimen-no11-oyama',       image: '/images/jikaseimen-no11-1.jpg',       lat: 35.781151, lng: 139.729279 },
  { name: 'Heart Restaurant 安ざわ家 本店', area: '上板橋', slug: 'anzawaya-itabashi-honten',    image: '/images/anzawaya-itabashi-1.jpg',     lat: 35.766113, lng: 139.672302 },
  { name: '麺や べらぼう',               area: '飯田橋',  slug: 'berabou-iidabashi',           image: '/images/berabou-iidabashi-01.jpg',    lat: 35.699116, lng: 139.744629 },
  { name: 'まるえ中華そば',              area: '巣鴨',    slug: 'marue-chuka-soba-sugamo',     image: '/images/marue-chuka-soba-sugamo-1.jpeg', lat: 35.733101, lng: 139.730469 },
];

const hardcodedSlugs = new Set(hardcodedShops.map(s => s.slug));
const posts = await getCollection('blog');
const dynamicShops = posts
  .filter(p => p.data.lat != null && p.data.lng != null)
  .map(p => ({
    name: p.data.shopName || p.data.title,
    area: p.data.tags?.[0] || '',
    slug: p.id.replace(/\.md$/, ''),
    image: p.data.image || '',
    lat: p.data.lat!,
    lng: p.data.lng!,
  }))
  .filter(s => !hardcodedSlugs.has(s.slug));

const shops = [...hardcodedShops, ...dynamicShops];
---

<Layout
  title="らーめんマップ | ラーメン、それから。"
  description={`ぽんが行ったラーメン店の地図。${shops.length}店舗掲載中。`}
  ogType="website"
>
  <style>
    .map-header { margin-bottom: 1rem; }
    .map-header h1 { font-family: 'Klee One', cursive; font-size: 1.4rem; color: #b5352a; margin-bottom: 0.2rem; }
    .map-header p  { color: #aaa; font-size: 0.82rem; }

    #google-map {
      width: 100%;
      height: 520px;
      border-radius: 16px;
      border: 1px solid #ede0d8;
      margin-bottom: 2rem;
    }

    @media (max-width: 600px) {
      #google-map { height: 380px; }
    }

    .section-label { font-size: .78rem; color: #ccc; margin-bottom: .75rem; letter-spacing: .05em; }
    .shop-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(155px,1fr)); gap: .55rem; }
    .shop-card { background: #fff; border: 1px solid #f0e8e4; border-radius: 10px; padding: .6rem .85rem; transition: border-color .15s; display: block; text-decoration: none; color: #2a2a2a; font-size: .83rem; font-weight: 500; }
    .shop-card:hover { border-color: #b5352a; color: #b5352a; }
    .shop-card-area { color: #ccc; font-size: .72rem; margin-top: 2px; }
    .shop-card-img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; margin-top: 7px; display: block; }

    @media(max-width:600px){
      .shop-grid { grid-template-columns: repeat(auto-fill,minmax(130px,1fr)); }
    }

    /* カスタム吹き出し */
    .gm-info-window img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 6px; }
    .gm-info-window-name { font-weight: 600; font-size: .88rem; color: #2a2a2a; margin-bottom: 2px; }
    .gm-info-window-area { font-size: .75rem; color: #bbb; margin-bottom: 6px; }
    .gm-info-window-link { font-size: .78rem; color: #b5352a; text-decoration: none; font-weight: 500; }
    .gm-info-window-link:hover { text-decoration: underline; }
  </style>

  <div class="map-header">
    <h1>らーめんマップ</h1>
    <p>ぽんが行ったラーメン店 — {shops.length}店舗</p>
  </div>

  <div id="google-map"></div>

  <p class="section-label">▼ 全{shops.length}店舗</p>
  <div class="shop-grid">
    {shops.map(shop => (
      <a class="shop-card" href={`/blog/${shop.slug}`}>
        <div>{shop.name}</div>
        <div class="shop-card-area">{shop.area}</div>
        <img class="shop-card-img" src={shop.image} alt={shop.name} loading="lazy" />
      </a>
    ))}
  </div>

  <script is:inline define:vars={{ shops }}>
    window.initMap = function () {
      var map = new google.maps.Map(document.getElementById('google-map'), {
        center: { lat: 35.710, lng: 139.700 },
        zoom: 11,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: false,
        styles: [
          { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
          { featureType: 'transit', elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
        ],
      });

      var infoWindow = new google.maps.InfoWindow();

      shops.forEach(function (shop) {
        var marker = new google.maps.Marker({
          position: { lat: shop.lat, lng: shop.lng },
          map: map,
          title: shop.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 9,
            fillColor: '#b5352a',
            fillOpacity: 1,
            strokeColor: '#fff',
            strokeWeight: 2.5,
          },
        });

        marker.addListener('click', function () {
          var content =
            '<div style="width:140px">' +
            (shop.image ? '<img src="' + shop.image + '" alt="' + shop.name + '" style="width:100%;height:80px;object-fit:cover;border-radius:8px;display:block;margin-bottom:6px">' : '') +
            '<div style="font-weight:600;font-size:.88rem;color:#2a2a2a;margin-bottom:2px">' + shop.name + '</div>' +
            '<div style="font-size:.75rem;color:#bbb;margin-bottom:6px">' + shop.area + '</div>' +
            '<a href="/blog/' + shop.slug + '" style="font-size:.78rem;color:#b5352a;font-weight:500">記事を読む →</a>' +
            '</div>';
          infoWindow.setContent(content);
          infoWindow.open(map, marker);
        });
      });
    };
  </script>

  <script
    src={`https://maps.googleapis.com/maps/api/js?key=${MAPS_KEY}&callback=initMap`}
    async
    defer
    is:inline
  ></script>
</Layout>
