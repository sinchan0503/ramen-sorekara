---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { shops as hardcodedShops } from '../data/shops';

const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? 'AIzaSyBGTnyVaOpnFnWHyyM1_lm7zcRs2jnwQsw';

const hardcodedSlugs = new Set(hardcodedShops.map(s => s.slug));
const posts = await getCollection('blog');
const dynamicShops = posts
  .filter(p => p.data.lat != null && p.data.lng != null)
  .map(p => ({
    name: p.data.shopName || p.data.title,
    area: p.data.tags?.[0] || '',
    slug: p.id.replace(/\.md$/, ''),
    image: p.data.image || '',
    lat: p.data.lat!,
    lng: p.data.lng!,
  }))
  .filter(s => !hardcodedSlugs.has(s.slug));

const shops = [...hardcodedShops, ...dynamicShops];
---

<Layout
  title="らーめんマップ | ラーメン、それから。"
  description={`ぽんが行ったラーメン店の地図。${shops.length}店舗掲載中。`}
  ogType="website"
>
  <style>
    .map-header { margin-bottom: 1rem; }
    .map-header h1 { font-family: 'Klee One', cursive; font-size: 1.4rem; color: #b5352a; margin-bottom: 0.2rem; }
    .map-header p  { color: #aaa; font-size: 0.82rem; }

    #google-map {
      width: 100%;
      height: 520px;
      border-radius: 16px;
      border: 1px solid #ede0d8;
      margin-bottom: 2rem;
    }

    @media (max-width: 600px) {
      #google-map { height: 380px; }
    }

    .section-label { font-size: .78rem; color: #ccc; margin-bottom: .75rem; letter-spacing: .05em; }
    .shop-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(155px,1fr)); gap: .55rem; }
    .shop-card { background: #fff; border: 1px solid #f0e8e4; border-radius: 10px; padding: .6rem .85rem; transition: border-color .15s; display: block; text-decoration: none; color: #2a2a2a; font-size: .83rem; font-weight: 500; }
    .shop-card:hover { border-color: #b5352a; color: #b5352a; }
    .shop-card-area { color: #ccc; font-size: .72rem; margin-top: 2px; }
    .shop-card-img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; margin-top: 7px; display: block; }

    @media(max-width:600px){
      .shop-grid { grid-template-columns: repeat(auto-fill,minmax(130px,1fr)); }
    }

    /* カスタム吹き出し */
    .gm-info-window img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 6px; }
    .gm-info-window-name { font-weight: 600; font-size: .88rem; color: #2a2a2a; margin-bottom: 2px; }
    .gm-info-window-area { font-size: .75rem; color: #bbb; margin-bottom: 6px; }
    .gm-info-window-link { font-size: .78rem; color: #b5352a; text-decoration: none; font-weight: 500; }
    .gm-info-window-link:hover { text-decoration: underline; }
  </style>

  <div class="map-header">
    <h1>らーめんマップ</h1>
    <p>ぽんが行ったラーメン店 — {shops.length}店舗</p>
  </div>

  <div id="google-map"></div>

  <p class="section-label">▼ 全{shops.length}店舗</p>
  <div class="shop-grid">
    {shops.map(shop => (
      <a class="shop-card" href={`/blog/${shop.slug}`}>
        <div>{shop.name}</div>
        <div class="shop-card-area">{shop.area}</div>
        <img class="shop-card-img" src={shop.image} alt={shop.name} loading="lazy" />
      </a>
    ))}
  </div>

  <script is:inline define:vars={{ shops }}>
    window.initMap = function () {
      var map = new google.maps.Map(document.getElementById('google-map'), {
        center: { lat: 35.710, lng: 139.700 },
        zoom: 11,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: false,
        styles: [
          { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
          { featureType: 'transit', elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
        ],
      });

      var infoWindow = new google.maps.InfoWindow();

      shops.forEach(function (shop) {
        var marker = new google.maps.Marker({
          position: { lat: shop.lat, lng: shop.lng },
          map: map,
          title: shop.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 9,
            fillColor: '#b5352a',
            fillOpacity: 1,
            strokeColor: '#fff',
            strokeWeight: 2.5,
          },
        });

        marker.addListener('click', function () {
          var content =
            '<div style="width:140px">' +
            (shop.image ? '<img src="' + shop.image + '" alt="' + shop.name + '" style="width:100%;height:80px;object-fit:cover;border-radius:8px;display:block;margin-bottom:6px">' : '') +
            '<div style="font-weight:600;font-size:.88rem;color:#2a2a2a;margin-bottom:2px">' + shop.name + '</div>' +
            '<div style="font-size:.75rem;color:#bbb;margin-bottom:6px">' + shop.area + '</div>' +
            '<a href="/blog/' + shop.slug + '" style="font-size:.78rem;color:#b5352a;font-weight:500">記事を読む →</a>' +
            '</div>';
          infoWindow.setContent(content);
          infoWindow.open(map, marker);
        });
      });
    };
  </script>

  <script
    src={`https://maps.googleapis.com/maps/api/js?key=${MAPS_KEY}&callback=initMap`}
    async
    defer
    is:inline
  ></script>
</Layout>
