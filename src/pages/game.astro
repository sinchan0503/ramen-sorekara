---
import Layout from '../layouts/Layout.astro';
---

<Layout title="呪文リズムゲーム｜ラーメン、それから。" description="二郎系の呪文をリズムに合わせて叩け！ラーメン、それから。のミニゲーム。">
  <div class="game-wrap">
    <h1>🥣 呪文を叩け！</h1>
    <p class="subtitle">落ちてくるトッピングを判定ラインでタップ！</p>

    <div id="screen-start" class="screen">
      <p class="store-voice">「ニンニク入れますか？」</p>
      <p class="how-to">トッピングが落ちてきたら<br>判定ラインでタップしよう<br><span class="judge-hint">PERFECT / GOOD / MISS</span></p>
      <button class="btn-primary" id="btn-start">はじめる</button>
    </div>

    <div id="screen-game" class="screen hidden">
      <div class="hud">
        <span class="hud-score">SCORE <strong id="score-val">0</strong></span>
        <span class="hud-combo" id="combo-display"></span>
      </div>
      <div class="field" id="field">
        <div class="judge-line" id="judge-line"></div>
        <div class="judge-text" id="judge-text"></div>
      </div>
      <button class="tap-btn" id="tap-btn">TAP</button>
      <div class="beat-dots" id="beat-dots">
        <span class="dot"></span><span class="dot"></span>
        <span class="dot"></span><span class="dot"></span>
      </div>
    </div>

    <div id="screen-result" class="screen hidden">
      <p class="result-label">あなたの注文</p>
      <p class="result-order" id="result-order"></p>
      <p class="result-score-txt">スコア: <strong id="result-score"></strong></p>
      <p class="result-pon" id="result-pon"></p>
      <div class="result-stats" id="result-stats"></div>
      <button class="btn-primary" id="btn-retry">もう一回</button>
    </div>
  </div>
</Layout>

<script>
  // ── 設定 ───────────────────────────────────────────
  const BPM = 110;
  const BEAT_MS = (60 / BPM) * 1000;
  const FIELD_HEIGHT = 320;
  const JUDGE_Y = FIELD_HEIGHT - 60; // 判定ラインのY位置(px)
  const FALL_BEATS = 4;              // 何ビートで落下するか
  const FALL_MS = BEAT_MS * FALL_BEATS;

  const PERFECT_WINDOW = 60;   // ±ms
  const GOOD_WINDOW    = 130;

  // トッピングシーケンス（登場ビート）
  const NOTES = [
    { beat: 2,  label: '🧄 ニンニク', key: 'ニンニク' },
    { beat: 4,  label: '🥬 野菜',     key: '野菜'     },
    { beat: 6,  label: '🍖 背脂',     key: '背脂'     },
    { beat: 8,  label: '🫙 カラメ',   key: 'カラメ'   },
    { beat: 10, label: '⬆️ マシ',    key: 'マシ'     },
  ];
  const TOTAL_BEATS = 13;

  // ぽんコメント
  const COMMENTS: Record<string, string> = {
    all:        '全部入り！！ 欲張りすぎやろ笑',
    none:       'なし！ キリッとしてるやん。',
    ninniku:    'ニンニクだけ。シンプルイズベスト。',
    yasai:      '野菜だけ。ヘルシー意識してる笑',
    abura:      '背脂だけ。こってり派やね。',
    karame:     'カラメだけ。醤油命。',
    mashi:      'マシだけ！ こだわりポイント謎笑',
    ninnikuYasai: 'ニンニク野菜。ザ・王道。',
    masimasi:   'マシが入ってる！ 勇者か。',
    default:    'それで正解かは知らんけど、おいしく食べてね。',
  };

  // ── 状態 ───────────────────────────────────────────
  let score = 0;
  let combo = 0;
  let hits: { key: string, judge: string }[] = [];
  let activeNotes: { el: HTMLElement, spawnTime: number, key: string, label: string, hit: boolean }[] = [];
  let gameStartTime = 0;
  let beatInterval: ReturnType<typeof setInterval> | null = null;
  let rafId: number | null = null;
  let currentBeat = 0;
  let audioCtx: AudioContext | null = null;
  let judgeTimer: ReturnType<typeof setTimeout> | null = null;

  // ── DOM ────────────────────────────────────────────
  const screenStart  = document.getElementById('screen-start')!;
  const screenGame   = document.getElementById('screen-game')!;
  const screenResult = document.getElementById('screen-result')!;
  const field        = document.getElementById('field')!;
  const scoreVal     = document.getElementById('score-val')!;
  const comboDisplay = document.getElementById('combo-display')!;
  const judgeText    = document.getElementById('judge-text')!;
  const tapBtn       = document.getElementById('tap-btn')!;
  const beatDots     = document.querySelectorAll<HTMLElement>('.dot');
  const resultOrder  = document.getElementById('result-order')!;
  const resultScoreEl= document.getElementById('result-score')!;
  const resultPon    = document.getElementById('result-pon')!;
  const resultStats  = document.getElementById('result-stats')!;

  // ── 音 ─────────────────────────────────────────────
  function getAudio() {
    if (!audioCtx) audioCtx = new AudioContext();
    return audioCtx;
  }
  function playClick(accent = false) {
    const ctx = getAudio();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.connect(g); g.connect(ctx.destination);
    osc.frequency.value = accent ? 900 : 500;
    g.gain.setValueAtTime(0.1, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
    osc.start(); osc.stop(ctx.currentTime + 0.06);
  }
  function playHit(type: 'perfect' | 'good' | 'miss') {
    const ctx = getAudio();
    const freq = type === 'perfect' ? 880 : type === 'good' ? 660 : 220;
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.connect(g); g.connect(ctx.destination);
    osc.frequency.value = freq;
    g.gain.setValueAtTime(0.15, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (type === 'miss' ? 0.2 : 0.12));
    osc.start(); osc.stop(ctx.currentTime + 0.25);
  }

  // ── ノート制御 ──────────────────────────────────────
  function spawnNote(label: string, key: string) {
    const el = document.createElement('div');
    el.className = 'note';
    el.textContent = label;
    field.appendChild(el);
    const note = { el, spawnTime: performance.now(), key, label, hit: false };
    activeNotes.push(note);
    return note;
  }

  function updateNotes() {
    const now = performance.now();
    activeNotes.forEach(note => {
      if (note.hit) return;
      const elapsed = now - note.spawnTime;
      const progress = elapsed / FALL_MS;
      const y = progress * FIELD_HEIGHT;
      note.el.style.top = y + 'px';

      // 通り過ぎたらMISS
      if (y > FIELD_HEIGHT + 20) {
        note.hit = true;
        note.el.classList.add('miss-note');
        setTimeout(() => note.el.remove(), 300);
        showJudge('MISS');
        playHit('miss');
        combo = 0;
        comboDisplay.textContent = '';
        hits.push({ key: note.key, judge: 'MISS' });
      }
    });
    activeNotes = activeNotes.filter(n => !n.hit || n.el.parentNode);
    rafId = requestAnimationFrame(updateNotes);
  }

  // ── 判定 ────────────────────────────────────────────
  function showJudge(type: string) {
    judgeText.textContent = type;
    judgeText.className = 'judge-text show ' + type.toLowerCase();
    if (judgeTimer) clearTimeout(judgeTimer);
    judgeTimer = setTimeout(() => judgeText.classList.remove('show'), 500);
  }

  function onTap() {
    tapBtn.classList.add('tapped');
    setTimeout(() => tapBtn.classList.remove('tapped'), 80);

    const now = performance.now();
    // 一番近いノートを探す
    let closest: typeof activeNotes[0] | null = null;
    let minDist = Infinity;
    activeNotes.forEach(note => {
      if (note.hit) return;
      const elapsed = now - note.spawnTime;
      const progress = elapsed / FALL_MS;
      const y = progress * FIELD_HEIGHT;
      const dist = Math.abs(y - JUDGE_Y);
      if (dist < minDist) { minDist = dist; closest = note; }
    });

    if (!closest) return;

    const elapsed = now - (closest as typeof activeNotes[0]).spawnTime;
    const targetTime = FALL_MS * (JUDGE_Y / FIELD_HEIGHT);
    const diff = Math.abs(elapsed - targetTime);

    let judge: 'PERFECT' | 'GOOD' | 'MISS';
    let pts: number;
    if (diff <= PERFECT_WINDOW) { judge = 'PERFECT'; pts = 300; }
    else if (diff <= GOOD_WINDOW)  { judge = 'GOOD';    pts = 150; }
    else return; // まだ遠すぎる

    combo++;
    pts += combo >= 3 ? combo * 10 : 0;
    score += pts;
    scoreVal.textContent = String(score);
    comboDisplay.textContent = combo >= 2 ? `${combo} COMBO!` : '';
    showJudge(judge);
    playHit(judge.toLowerCase() as 'perfect' | 'good');
    hits.push({ key: (closest as typeof activeNotes[0]).key, judge });
    (closest as typeof activeNotes[0]).hit = true;
    (closest as typeof activeNotes[0]).el.classList.add('hit-note');
    setTimeout(() => (closest as typeof activeNotes[0]).el.remove(), 200);
  }

  // ── ゲーム制御 ──────────────────────────────────────
  function show(el: HTMLElement) {
    [screenStart, screenGame, screenResult].forEach(s => s.classList.add('hidden'));
    el.classList.remove('hidden');
  }

  function startGame() {
    score = 0; combo = 0; hits = []; activeNotes = []; currentBeat = 0;
    scoreVal.textContent = '0';
    comboDisplay.textContent = '';
    judgeText.textContent = '';
    field.querySelectorAll('.note').forEach(n => n.remove());
    show(screenGame);
    gameStartTime = performance.now();

    beatInterval = setInterval(() => {
      currentBeat++;
      const accent = currentBeat % 4 === 1;
      playClick(accent);
      const dotIdx = (currentBeat - 1) % 4;
      beatDots.forEach((d, i) => d.classList.toggle('active', i === dotIdx));

      // ノート生成
      const noteData = NOTES.find(n => n.beat === currentBeat);
      if (noteData) spawnNote(noteData.label, noteData.key);

      if (currentBeat >= TOTAL_BEATS) {
        clearInterval(beatInterval!);
        setTimeout(endGame, FALL_MS + 200);
      }
    }, BEAT_MS);

    rafId = requestAnimationFrame(updateNotes);
  }

  function endGame() {
    if (rafId) cancelAnimationFrame(rafId);
    field.querySelectorAll('.note').forEach(n => n.remove());
    beatDots.forEach(d => d.classList.remove('active'));

    const hitKeys = hits.filter(h => h.judge !== 'MISS').map(h => h.key);
    const s = new Set(hitKeys);
    const perfects = hits.filter(h => h.judge === 'PERFECT').length;
    const goods    = hits.filter(h => h.judge === 'GOOD').length;
    const misses   = hits.filter(h => h.judge === 'MISS').length + (NOTES.length - hits.length);

    resultOrder.textContent  = hitKeys.length === 0 ? 'なし' : hitKeys.join(' ・ ');
    resultScoreEl.textContent = String(score);
    resultPon.textContent    = `ぽん:「${getComment(s, hitKeys)}」`;
    resultStats.innerHTML    =
      `<span class="s-perfect">PERFECT ${perfects}</span>　` +
      `<span class="s-good">GOOD ${goods}</span>　` +
      `<span class="s-miss">MISS ${misses}</span>`;

    show(screenResult);
  }

  function getComment(s: Set<string>, keys: string[]): string {
    if (keys.length === 0) return COMMENTS.none;
    if (s.has('マシ')) return keys.length >= 4 ? COMMENTS.masimasi : COMMENTS.mashi;
    if (keys.length === NOTES.length - 1 || keys.length === NOTES.length) return COMMENTS.all;
    if (s.size === 1 && s.has('ニンニク')) return COMMENTS.ninniku;
    if (s.size === 1 && s.has('野菜'))    return COMMENTS.yasai;
    if (s.size === 1 && s.has('背脂'))    return COMMENTS.abura;
    if (s.size === 1 && s.has('カラメ'))  return COMMENTS.karame;
    if (s.has('ニンニク') && s.has('野菜') && keys.length === 2) return COMMENTS.ninnikuYasai;
    return COMMENTS.default;
  }

  // ── イベント ────────────────────────────────────────
  document.getElementById('btn-start')!.addEventListener('click', startGame);
  document.getElementById('btn-retry')!.addEventListener('click', startGame);
  tapBtn.addEventListener('click', onTap);
  document.addEventListener('keydown', e => {
    if (e.code === 'Space' && !screenGame.classList.contains('hidden')) {
      e.preventDefault();
      onTap();
    }
  });
</script>

<style>
  .game-wrap {
    max-width: 400px;
    margin: 0 auto;
    text-align: center;
    user-select: none;
  }
  h1 {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.7rem;
    color: #1a1a1a;
    margin-bottom: 6px;
  }
  .subtitle { font-size: 0.82rem; color: #999; margin-bottom: 28px; }

  .screen { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .hidden { display: none !important; }

  /* ── start ── */
  .store-voice {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    color: #2a2a2a;
  }
  .how-to { font-size: 0.88rem; color: #888; line-height: 2; }
  .judge-hint { font-size: 0.78rem; color: #b5352a; font-weight: 600; }

  /* ── hud ── */
  .hud {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 600;
    color: #888;
    padding: 0 4px;
  }
  .hud-score strong { color: #b5352a; font-size: 1.1rem; }
  .hud-combo { color: #e07b00; font-size: 0.9rem; font-weight: 700; }

  /* ── field ── */
  .field {
    width: 100%;
    height: 320px;
    background: #fff;
    border-radius: 16px;
    border: 1px solid #f0e8e4;
    position: relative;
    overflow: hidden;
  }
  .judge-line {
    position: absolute;
    left: 0; right: 0;
    bottom: 60px;
    height: 3px;
    background: #b5352a;
    opacity: 0.6;
  }
  .judge-line::before {
    content: 'TAP HERE';
    position: absolute;
    right: 8px;
    top: -18px;
    font-size: 0.62rem;
    color: #b5352a;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  /* ── notes ── */
  :global(.note) {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: #b5352a;
    color: #fff;
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 3px 10px rgba(181,53,42,0.3);
    transition: opacity 0.15s;
  }
  :global(.hit-note)  { opacity: 0; transform: translateX(-50%) scale(1.2); }
  :global(.miss-note) { opacity: 0; background: #ccc; }

  /* ── judge text ── */
  .judge-text {
    position: absolute;
    left: 50%;
    top: 40%;
    transform: translate(-50%, -50%);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s;
  }
  .judge-text.show  { opacity: 1; }
  .judge-text.perfect { color: #f0a500; }
  .judge-text.good    { color: #4caf50; }
  .judge-text.miss    { color: #aaa; }

  /* ── tap button ── */
  .tap-btn {
    width: 100%;
    padding: 22px;
    background: #b5352a;
    color: #fff;
    border: none;
    border-radius: 16px;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: transform 0.08s, background 0.08s;
    font-family: 'Noto Sans JP', sans-serif;
  }
  .tap-btn.tapped { transform: scale(0.95); background: #9b2d22; }

  /* ── beat dots ── */
  .beat-dots { display: flex; gap: 10px; }
  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: #e0d0c8;
    transition: background 0.05s, transform 0.05s;
  }
  .dot.active { background: #b5352a; transform: scale(1.3); }

  /* ── result ── */
  .result-label { font-size: 0.82rem; color: #aaa; letter-spacing: 0.08em; }
  .result-order {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.5rem;
    color: #b5352a;
    font-weight: 700;
    letter-spacing: 0.05em;
    min-height: 1.5em;
  }
  .result-score-txt { font-size: 0.9rem; color: #888; }
  .result-score-txt strong { color: #1a1a1a; font-size: 1.2rem; }
  .result-pon {
    font-size: 0.95rem;
    background: #fdf0ed;
    padding: 12px 20px;
    border-radius: 12px;
    color: #555;
    line-height: 1.7;
    width: 100%;
  }
  .result-stats { font-size: 0.8rem; }
  :global(.s-perfect) { color: #f0a500; font-weight: 700; }
  :global(.s-good)    { color: #4caf50; font-weight: 700; }
  :global(.s-miss)    { color: #aaa;    font-weight: 700; }

  .btn-primary {
    padding: 13px 36px;
    background: #b5352a;
    color: #fff;
    border: none;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-primary:hover { background: #9b2d22; transform: translateY(-1px); }
</style>
