---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagSet = new Set(posts.flatMap(p => p.data.tags ?? []));
  return [...tagSet].map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = (await getCollection('blog'))
  .filter(p => p.data.pubDate <= new Date() && (p.data.tags ?? []).includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={`#${tag} の記事 | ラーメン、それから。`}
  description={`「${tag}」タグの記事一覧。ラーメン、それから。`}
>
  <div class="tag-header">
    <a href="/blog" class="back-link">← 記事一覧</a>
    <h1><span class="tag-badge">#{tag}</span></h1>
    <p class="tag-count">{allPosts.length}件</p>
  </div>

  <div class="card-grid">
    {allPosts.map(post => (
      <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="post-card">
        <div class="card-thumb">
          {post.data.image
            ? <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" style={`object-position: ${post.data.imagePosition ?? 'center 30%'}`} />
            : <span class="card-emoji">{post.data.emoji ?? '🍜'}</span>
          }
        </div>
        <div class="card-body">
          <time>{post.data.pubDate.toLocaleDateString('ja-JP')}</time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .tag-header {
    margin-bottom: 40px;
  }
  .back-link {
    font-size: 0.8rem;
    color: #b5352a;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }
  h1 {
    margin: 16px 0 8px;
  }
  .tag-badge {
    display: inline-block;
    background: #fdf0ed;
    color: #b5352a;
    font-size: 1.4rem;
    font-family: 'Shippori Mincho', serif;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .tag-count {
    font-size: 0.85rem;
    color: #999;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .post-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #f0e8e4;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.07);
  }
  .card-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #fdf0ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .card-emoji { font-size: 3rem; }
  .card-body { padding: 16px 20px 20px; }
  .card-body time {
    font-size: 0.75rem;
    color: #bbb;
  }
  .card-body h2 {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.05rem;
    font-weight: 600;
    margin: 6px 0 8px;
    color: #2a2a2a;
    line-height: 1.5;
  }
  .card-body p {
    font-size: 0.82rem;
    color: #999;
    line-height: 1.6;
  }
</style>
