---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const is4komaPost = post.id.includes('4koma');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.id.includes('4koma') === is4komaPost)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const is4koma = post.id.includes('4koma');

const siteUrl = 'https://ramen-sorekara.com';
const postUrl = `${siteUrl}/blog/${post.id.replace(/\.md$/, '')}`;
const pubDate = post.data.pubDate.toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": pubDate,
  "url": postUrl,
  "author": { "@type": "Person", "name": "ぽん" },
  "publisher": { "@type": "Organization", "name": "ラーメン、それから。", "url": siteUrl },
  ...(post.data.image ? { "image": `${siteUrl}${post.data.image}` } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "ブログ", "item": `${siteUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl },
  ],
};
---

<Layout title={`${post.data.title} | ラーメン、それから。`} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">ホーム</a>
    <span>›</span>
    <a href="/blog">ブログ</a>
    <span>›</span>
    <span>{post.data.title}</span>
  </nav>
  <div class={`post-layout${is4koma ? ' layout-4koma' : ''}`}>
    <article class="post">
      <header class="post-header">
        <time>{post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
      </header>
      <div class="post-content">
        <Content />
      </div>
      {relatedPosts.length > 0 && (
        <div class="related-posts">
          <h2 class="related-title">{is4koma ? 'ほかの四コマ' : 'ほかの記事'}</h2>
          <div class="related-grid">
            {relatedPosts.map(p => (
              <a href={`/blog/${p.id.replace(/\.md$/, '')}`} class="related-card">
                <div class="related-thumb">
                  {p.data.image
                    ? <img src={p.data.image} alt={p.data.title} />
                    : <span class="related-emoji">{p.data.emoji ?? '🍜'}</span>
                  }
                </div>
                <p class="related-card-title">{p.data.title}</p>
              </a>
            ))}
          </div>
        </div>
      )}
      <div class="post-footer">
        <a href={is4koma ? '/4koma' : '/blog'}>{is4koma ? '← 四コマ一覧に戻る' : '← 記事一覧に戻る'}</a>
      </div>
    </article>
    <aside class="post-sidebar">
      <CommentSection slug={post.id.replace(/\.md$/, '')} />
    </aside>
  </div>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: #bbb;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: #b5352a;
    text-decoration: none;
  }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span:last-child {
    color: #999;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr 320px;
    }
  }

  .post {
    min-width: 0;
  }

  /* ── ヘッダー ── */
  .post-header {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 2px solid #f0e8e4;
  }
  .post-header time {
    display: block;
    font-size: 0.8rem;
    color: #c0a090;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .post-header h1 {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    font-weight: 600;
    line-height: 1.5;
    color: #1a1a1a;
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }
  .post-desc {
    font-size: 1rem;
    color: #999;
    line-height: 1.8;
  }

  /* ── 本文 ── */
  .post-content {
    font-size: 1.08rem;
    line-height: 2.1;
    color: #2e2e2e;
  }

  .post-content p {
    margin-bottom: 28px;
  }

  .post-content h2 {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    font-weight: 600;
    margin: 60px 0 20px;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    padding-left: 16px;
    border-left: 3px solid #b5352a;
    line-height: 1.6;
  }

  .post-content blockquote {
    border: none;
    padding: 24px 28px 24px 48px;
    margin: 40px 0;
    background: #fdf8f5;
    border-radius: 12px;
    color: #999;
    font-size: 0.9rem;
    line-height: 2;
    position: relative;
  }
  .post-content blockquote::before {
    content: '"';
    font-family: 'Shippori Mincho', serif;
    font-size: 4rem;
    color: #e8c4bb;
    position: absolute;
    top: 4px;
    left: 12px;
    line-height: 1;
  }

  .post-content hr {
    border: none;
    border-top: 1px solid #f0e8e4;
    margin: 40px 0;
  }

  /* ── 関連記事 ── */
  .related-posts {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid #f0e8e4;
  }
  .related-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 20px;
    letter-spacing: 0.04em;
    border-left: none;
    padding-left: 0;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 600px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .related-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #f0e8e4;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.07);
  }
  .related-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #fdf0ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .related-emoji { font-size: 2rem; }
  .related-card-title {
    font-size: 0.78rem;
    color: #555;
    padding: 8px 10px 10px;
    line-height: 1.5;
  }

  /* ── フッター ── */
  .post-footer {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid #f0e8e4;
  }
  .post-footer a {
    color: #b5352a;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .post-footer a:hover { text-decoration: underline; }
</style>

<style is:global>
  /* サイドバー内のコメント欄リセット */
  .post-sidebar .comments {
    max-width: 100%;
    margin: 0;
    padding-top: 0;
    border-top: none;
    position: sticky;
    top: 80px;
  }

  /* 記事内の画像 */
  .post-content img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 4px 0 40px;
    box-shadow: 0 6px 28px rgba(0,0,0,0.10);
  }

  /* 四コマ専用レイアウト: ヘッダーをコンパクトにして画像を1画面に収める */
  .layout-4koma .post-header {
    margin-bottom: 16px;
    padding-bottom: 16px;
  }
  .layout-4koma .post-header time {
    margin-bottom: 8px;
  }
  .layout-4koma .post-header h1 {
    font-size: 1.1rem;
    margin-bottom: 0;
  }
  .layout-4koma .post-desc {
    display: none;
  }

  /* 四コマ画像: 1画面に収まるよう高さ制限 */
  .layout-4koma .post-content img {
    width: auto !important;
    max-height: calc(100dvh - 260px);
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: block;
  }

  @media (max-width: 600px) {
    .layout-4koma .post-content img {
      max-height: calc(100dvh - 130px);
    }
  }
</style>
