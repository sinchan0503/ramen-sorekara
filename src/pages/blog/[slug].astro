---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';
import AdUnit from '../../components/AdUnit.astro';
import { shops } from '../../data/shops';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog'))
    .filter(p => p.data.pubDate <= now);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('blog')).filter(p => p.data.pubDate <= new Date());
const is4komaPost = post.id.includes('4koma');
const sameCategoryPosts = allPosts
  .filter(p => p.id.includes('4koma') === is4komaPost)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const currentIndex = sameCategoryPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? sameCategoryPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sameCategoryPosts.length - 1 ? sameCategoryPosts[currentIndex + 1] : null;

const postTags = post.data.tags ?? [];
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.id.includes('4koma') === is4komaPost)
  .map(p => {
    const sharedTags = (p.data.tags ?? []).filter(t => postTags.includes(t)).length;
    return { post: p, score: sharedTags };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ post }) => post);

const recentPosts = allPosts
  .filter(p => p.id !== post.id && !p.id.includes('4koma'))
  .slice(0, 5);
const is4koma = post.id.includes('4koma');

const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? 'AIzaSyBGTnyVaOpnFnWHyyM1_lm7zcRs2jnwQsw';

const postSlug = post.id.replace(/\.md$/, '');
const shopCoord = shops.find(s => s.slug === postSlug) ?? null;

const siteUrl = 'https://ramen-sorekara.com';
const postUrl = `${siteUrl}/blog/${post.id.replace(/\.md$/, '')}`;
const pubDate = post.data.pubDate.toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": pubDate,
  "url": postUrl,
  "author": { "@type": "Person", "name": "ぽん" },
  "publisher": { "@type": "Organization", "name": "ラーメン、それから。", "url": siteUrl },
  ...(post.data.image ? { "image": `${siteUrl}${post.data.image}` } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "ブログ", "item": `${siteUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl },
  ],
};
---

<Layout
  title={`${post.data.title} | ラーメン、それから。`}
  description={post.data.description}
  noindex={is4koma}
  image={post.data.image ?? undefined}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">ホーム</a>
    <span>›</span>
    <a href="/blog">ブログ</a>
    <span>›</span>
    <span>{post.data.title}</span>
  </nav>
  <div class={`post-layout${is4koma ? ' layout-4koma' : ''}`}>
    <article class="post">
      <header class="post-header">
        <time>{post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map(tag => (
              <a href={`/blog/tag/${tag}`} class="tag-chip">#{tag}</a>
            ))}
          </div>
        )}
      </header>
      <div class="post-content">
        <Content />
      </div>

      {!is4koma && shopCoord && (
        <div class="shop-map-section">
          <p class="shop-map-label">お店の場所</p>
          <div id="shop-map"></div>
          <a href="/map" class="shop-map-link">全店舗マップを見る →</a>
          <script is:inline define:vars={{ shopCoord, MAPS_KEY }}>
            window.__initShopMap = function () {
              var map = new google.maps.Map(document.getElementById('shop-map'), {
                center: { lat: shopCoord.lat, lng: shopCoord.lng },
                zoom: 16,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false,
                styles: [
                  { featureType: 'poi', elementType: 'labels', stylers: [{ visibility: 'off' }] },
                  { featureType: 'transit', elementType: 'labels.icon', stylers: [{ visibility: 'off' }] },
                ],
              });
              new google.maps.Marker({
                position: { lat: shopCoord.lat, lng: shopCoord.lng },
                map: map,
                icon: {
                  path: google.maps.SymbolPath.CIRCLE,
                  scale: 10,
                  fillColor: '#b5352a',
                  fillOpacity: 1,
                  strokeColor: '#fff',
                  strokeWeight: 2.5,
                },
              });
            };
          </script>
          <script src={`https://maps.googleapis.com/maps/api/js?key=${MAPS_KEY}&callback=__initShopMap`} async defer is:inline></script>
        </div>
      )}

      <AdUnit />

      {relatedPosts.length > 0 && (
        <div class="related-posts">
          <h2 class="related-title">{is4koma ? 'ほかの四コマ' : 'ほかの記事'}</h2>
          <div class="related-grid">
            {relatedPosts.map(p => (
              <a href={`/blog/${p.id.replace(/\.md$/, '')}`} class="related-card">
                <div class="related-thumb">
                  {p.data.image
                    ? <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
                    : <span class="related-emoji">{p.data.emoji ?? '🍜'}</span>
                  }
                </div>
                <p class="related-card-title">{p.data.title}</p>
              </a>
            ))}
          </div>
        </div>
      )}
      <nav class="post-nav">
        <div class="post-nav-item post-nav-prev">
          {prevPost && (
            <a href={`/blog/${prevPost.id.replace(/\.md$/, '')}`}>
              <div class="post-nav-thumb">
                {prevPost.data.image
                  ? <img src={prevPost.data.image} alt={prevPost.data.title} loading="lazy" decoding="async" />
                  : <span class="post-nav-emoji">{prevPost.data.emoji ?? '🍜'}</span>
                }
              </div>
              <div class="post-nav-text">
                <span class="post-nav-label">← 前の記事</span>
                <span class="post-nav-title">{prevPost.data.title}</span>
              </div>
            </a>
          )}
        </div>
        <div class="post-nav-item post-nav-next">
          {nextPost && (
            <a href={`/blog/${nextPost.id.replace(/\.md$/, '')}`}>
              <div class="post-nav-thumb">
                {nextPost.data.image
                  ? <img src={nextPost.data.image} alt={nextPost.data.title} loading="lazy" decoding="async" />
                  : <span class="post-nav-emoji">{nextPost.data.emoji ?? '🍜'}</span>
                }
              </div>
              <div class="post-nav-text">
                <span class="post-nav-label">次の記事 →</span>
                <span class="post-nav-title">{nextPost.data.title}</span>
              </div>
            </a>
          )}
        </div>
      </nav>
      <div class="post-footer">
        <a href={is4koma ? '/4koma' : '/blog'}>{is4koma ? '← 四コマ一覧に戻る' : '← 記事一覧に戻る'}</a>
      </div>

      {!is4koma && recentPosts.length > 0 && (
        <div class="mobile-recent">
          <h2 class="related-title">最新記事</h2>
          <ul class="sidebar-list">
            {recentPosts.map(p => (
              <li>
                <a href={`/blog/${p.id.replace(/\.md$/, '')}`} class="sidebar-item">
                  <div class="sidebar-thumb">
                    {p.data.image
                      ? <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
                      : <span class="sidebar-emoji">{p.data.emoji ?? '🍜'}</span>
                    }
                  </div>
                  <span class="sidebar-item-title">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <CommentSection slug={post.id.replace(/\.md$/, '')} />
    </article>
    <aside class="post-sidebar">
      <div class="sidebar-recent">
        <h2 class="sidebar-title">最新記事</h2>
        <ul class="sidebar-list">
          {recentPosts.map(p => (
            <li>
              <a href={`/blog/${p.id.replace(/\.md$/, '')}`} class="sidebar-item">
                <div class="sidebar-thumb">
                  {p.data.image
                    ? <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
                    : <span class="sidebar-emoji">{p.data.emoji ?? '🍜'}</span>
                  }
                </div>
                <span class="sidebar-item-title">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      {postTags.length > 0 && (
        <div class="sidebar-tags">
          <h2 class="sidebar-title">タグ</h2>
          <div class="sidebar-tag-list">
            {postTags.map(tag => (
              <a href={`/blog/tag/${tag}`} class="tag-chip">#{tag}</a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: #bbb;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: #b5352a;
    text-decoration: none;
  }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span:last-child {
    color: #999;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr 320px;
    }
  }

  .post {
    min-width: 0;
  }

  /* ── ヘッダー ── */
  .post-header {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 2px solid #f0e8e4;
  }
  .post-header time {
    display: block;
    font-size: 0.8rem;
    color: #c0a090;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .post-header h1 {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    font-weight: 600;
    line-height: 1.5;
    color: #1a1a1a;
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }
  .post-desc {
    font-size: 1rem;
    color: #999;
    line-height: 1.8;
  }

  /* ── タグ ── */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .tag-chip {
    display: inline-block;
    background: #fdf0ed;
    color: #b5352a;
    font-size: 0.78rem;
    padding: 4px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }
  .tag-chip:hover { background: #f5ddd8; }

  /* ── モバイル用最新記事（PC非表示） ── */
  .mobile-recent {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid #f0e8e4;
  }
  @media (min-width: 900px) {
    .mobile-recent { display: none; }
  }

  /* ── サイドバー最新記事 ── */
  .sidebar-recent {
    margin-bottom: 40px;
  }
  .sidebar-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f0e8e4;
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    transition: background 0.15s;
    padding: 4px;
  }
  .sidebar-item:hover { background: #fdf8f5; }
  .sidebar-thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: #fdf0ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sidebar-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sidebar-emoji { font-size: 1.4rem; }

  /* ── サイドバータグ ── */
  .sidebar-tags {
    margin-top: 32px;
  }
  .sidebar-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sidebar-item-title {
    font-size: 0.8rem;
    color: #333;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 本文 ── */
  .post-content {
    font-size: 1.08rem;
    line-height: 2.1;
    color: #2e2e2e;
  }

  .post-content p {
    margin-bottom: 28px;
  }

  .post-content h2 {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.3rem;
    font-weight: 600;
    margin: 60px 0 20px;
    color: #1a1a1a;
    letter-spacing: 0.04em;
    padding-left: 16px;
    border-left: 3px solid #b5352a;
    line-height: 1.6;
  }

  .post-content blockquote {
    border: none;
    padding: 24px 28px 24px 48px;
    margin: 40px 0;
    background: #fdf8f5;
    border-radius: 12px;
    color: #999;
    font-size: 0.9rem;
    line-height: 2;
    position: relative;
  }
  .post-content blockquote::before {
    content: '"';
    font-family: 'Shippori Mincho', serif;
    font-size: 4rem;
    color: #e8c4bb;
    position: absolute;
    top: 4px;
    left: 12px;
    line-height: 1;
  }

  .post-content hr {
    border: none;
    border-top: 1px solid #f0e8e4;
    margin: 40px 0;
  }

  /* ── 店舗マップ ── */
  .shop-map-section {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid #f0e8e4;
  }
  .shop-map-label {
    font-size: 0.78rem;
    color: #bbb;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  #shop-map {
    width: 100%;
    height: 240px;
    border-radius: 12px;
    border: 1px solid #ede0d8;
  }
  .shop-map-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.8rem;
    color: #b5352a;
    text-decoration: none;
    font-weight: 500;
  }
  .shop-map-link:hover { text-decoration: underline; }

  /* ── 関連記事 ── */
  .related-posts {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid #f0e8e4;
  }
  .related-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 20px;
    letter-spacing: 0.04em;
    border-left: none;
    padding-left: 0;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 600px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .related-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #f0e8e4;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.07);
  }
  .related-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #fdf0ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .related-emoji { font-size: 2rem; }
  .related-card-title {
    font-size: 0.78rem;
    color: #555;
    padding: 8px 10px 10px;
    line-height: 1.5;
  }

  /* ── 前後ナビ ── */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid #f0e8e4;
  }
  .post-nav-item a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid #f0e8e4;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
    height: 100%;
  }
  .post-nav-item a:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.07);
  }
  .post-nav-next a { flex-direction: row-reverse; }
  .post-nav-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 8px;
    overflow: hidden;
    background: #fdf0ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .post-nav-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-nav-emoji { font-size: 1.6rem; }
  .post-nav-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .post-nav-next .post-nav-text { text-align: right; }
  .post-nav-label {
    font-size: 0.75rem;
    color: #b5352a;
    font-weight: 500;
  }
  .post-nav-title {
    font-size: 0.82rem;
    color: #333;
    line-height: 1.5;
    font-family: 'Shippori Mincho', serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-next a { flex-direction: row; }
    .post-nav-next .post-nav-text { text-align: left; }
  }

  /* ── フッター ── */
  .post-footer {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid #f0e8e4;
  }
  .post-footer a {
    color: #b5352a;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .post-footer a:hover { text-decoration: underline; }
</style>

<style is:global>
  /* 記事内の画像 */
  .post-content img {
    display: block;
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 16px;
    margin: 4px auto 40px;
    box-shadow: 0 6px 28px rgba(0,0,0,0.10);
  }

  /* 四コマ専用レイアウト: ヘッダーをコンパクトにして画像を1画面に収める */
  .layout-4koma .post-header {
    margin-bottom: 16px;
    padding-bottom: 16px;
  }
  .layout-4koma .post-header time {
    margin-bottom: 8px;
  }
  .layout-4koma .post-header h1 {
    font-size: 1.1rem;
    margin-bottom: 0;
  }
  .layout-4koma .post-desc {
    display: none;
  }

  /* 四コマ画像: 1画面に収まるよう高さ制限 */
  .layout-4koma .post-content img {
    width: auto !important;
    max-height: calc(100dvh - 260px);
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: block;
  }

  @media (max-width: 600px) {
    .layout-4koma .post-content img {
      max-height: calc(100dvh - 130px);
    }
  }
</style>
